{
  "name": "ideamans-banner-generator",
  "version": "0.3.1",
  "description": "Generator web server of banners like OGP images.",
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.js",
  "repository": "https://github.com/ideamans/banner-generator",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "build": "run-p build:*",
    "build:module": "tsc -p tsconfig.json",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"src/**/*.ts\" --write",
    "fix:lint": "eslint src --fix",
    "test": "run-s build test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier \"src/**/*.ts\" --list-different",
    "test:spelling": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "nyc --silent ava",
    "check-cli": "run-s test diff-integration-tests check-integration-tests",
    "check-integration-tests": "run-s check-integration-test:*",
    "diff-integration-tests": "mkdir -p diff && rm -rf diff/test && cp -r test diff/test && rm -rf diff/test/test-*/.git && cd diff && git init --quiet && git add -A && git commit --quiet --no-verify --allow-empty -m 'WIP' && echo '\\n\\nCommitted most recent integration test output in the \"diff\" directory. Review the changes with \"cd diff && git diff HEAD\" or your preferred git diff viewer.'",
    "watch:build": "tsc -p tsconfig.json -w",
    "watch:test": "nyc --silent ava --watch",
    "cov": "run-s build test:unit cov:html cov:lcov && open-cli coverage/index.html",
    "cov:html": "nyc report --reporter=html",
    "cov:lcov": "nyc report --reporter=lcov",
    "cov:check": "nyc report && nyc check-coverage --lines 100 --functions 100 --branches 100",
    "doc": "run-s doc:html && open-cli build/docs/index.html",
    "doc:html": "typedoc src/ --entryPointStrategy expand --exclude \"**/*.spec.ts\" --out build/docs",
    "doc:json": "typedoc src/ --entryPointStrategy expand --exclude \"**/*.spec.ts\" --json build/docs/typedoc.json",
    "doc:publish": "gh-pages -m \"[ci skip] Updates\" -d build/docs",
    "version": "standard-version",
    "reset-hard": "git clean -dfx && git reset --hard && yarn",
    "prepare-release": "run-s reset-hard test cov:check doc:html version doc:publish",
    "adhoc": "run-s build && node dist/adhoc.js",
    "server": "node dist/server.js"
  },
  "engines": {
    "node": ">=22.20"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.0.0",
    "axios": "^1.20.0",
    "color-parse": "^2.1.2",
    "dot-prop": "^10.2.0",
    "fastify": "^5.12.7",
    "image-size": "^2.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "text-to-svg": "^3.1.5",
    "ts-deepmerge": "^8.0.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.1",
    "@types/node": "^22",
    "@types/text-to-svg": "^3.1.4",
    "ava": "^8.1.2",
    "cspell": "^10.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "gh-pages": "^6.3.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.10",
    "sharp-iqa": "^1.0.0",
    "standard-version": "^9.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "files": [
    "dist",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "workerThreads": false,
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    },
    "files": [
      "!dist/**"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120,
    "trailingComma": "es5"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "exclude": [
      "**/*.spec.js"
    ]
  },
  "resolutions": {
    "sharp-iqa/sharp": "^0.35.5"
  }
}
